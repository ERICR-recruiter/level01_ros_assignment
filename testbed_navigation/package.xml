<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>testbed_navigation</name>
  <version>0.1.0</version>
  <description>
    Manually composed Nav2 navigation workflow for the Testbed-T1.0.0 robot:
    map loading (map_server), localization (AMCL) and navigation (planner, controller,
    BT navigator, behaviors, velocity smoother, collision monitor), each with its own
    launch file and lifecycle manager. Does not use nav2_bringup.
  </description>
  <maintainer email="narendhrankrishnasamy@gmail.com">K NARENDHRAN</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Launch system -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_common</exec_depend>

  <!-- Nav2 servers (one per launch stage) -->
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_behavior_tree</exec_depend>

  <!-- Nav2 plugins selected in config/nav2_params.yaml -->
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>

  <!-- Visualisation -->
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Odometry EKF started by bringup_all.launch.py -->
  <exec_depend>robot_localization</exec_depend>

  <!-- Robot, world and map from the starter packages -->
  <exec_depend>testbed_bringup</exec_depend>
  <exec_depend>testbed_gazebo</exec_depend>
  <exec_depend>testbed_description</exec_depend>

  <!-- scripts/send_goals.py -->
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
