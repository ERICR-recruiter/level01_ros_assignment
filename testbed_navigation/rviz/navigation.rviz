Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Tree Height: 500
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 22
      Color: 160; 160; 164
      Alpha: 0.3
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Color Scheme: map
      Alpha: 1
      Draw Behind: true
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Color Scheme: costmap
      Alpha: 0.3
      Draw Behind: false
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
      Color Scheme: costmap
      Alpha: 0.6
      Draw Behind: false
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 5
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 0.5
      Value: false
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Alpha: 1
      Value: true
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL Particles
      Enabled: true
      Topic:
        Value: /particle_cloud
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Shape: Arrow (Flat)
      Color: 0; 180; 0
      Alpha: 1
      Arrow Length: 0.15
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Topic:
        Value: /plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
      Line Style: Billboards
      Line Width: 0.04
      Color: 0; 120; 255
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Topic:
        Value: /local_plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
      Line Style: Billboards
      Line Width: 0.03
      Color: 255; 170; 0
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/PointStamped
      Name: RPP Lookahead
      Enabled: true
      Topic:
        Value: /lookahead_point
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
      Color: 255; 0; 255
      Radius: 0.06
      Alpha: 1
      History Length: 1
      Value: true
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
      Color: 0; 255; 0
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Polygon
      Name: Collision Stop Zone
      Enabled: true
      Topic:
        Value: /polygon_stop
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
      Color: 255; 0; 0
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Polygon
      Name: Collision Slowdown Zone
      Enabled: true
      Topic:
        Value: /polygon_slowdown
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
      Color: 255; 200; 0
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Goal
      Enabled: true
      Topic:
        Value: /goal_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
      Shape: Arrow
      Color: 255; 25; 0
      Shaft Length: 0.4
      Shaft Radius: 0.04
      Head Length: 0.15
      Head Radius: 0.08
      Alpha: 1
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.0685
    - Class: nav2_rviz_plugins/GoalTool
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 38
      X: 0
      Y: 0
      Angle: 0
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Width: 1500
  Height: 950
  Navigation 2:
    collapsed: false
  Displays:
    collapsed: false
