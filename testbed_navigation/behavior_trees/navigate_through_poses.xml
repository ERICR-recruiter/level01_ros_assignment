<!-- Remove reached waypoints before planning the remaining path. -->
<root BTCPP_format="4">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="2" name="NavigateRecovery">
      <PipelineSequence name="NavigateWaypoints">
        <RateController hz="0.5">
          <ReactiveSequence name="PlanThroughWaypoints">
            <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.7"/>
            <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="NavFn"/>
          </ReactiveSequence>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath"/>
      </PipelineSequence>

      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
          <Wait wait_duration="1.0"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>